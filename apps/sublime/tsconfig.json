{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "renderer/src/**/*",
    "../../packages/shared/src/global.d.ts"
  ],
  "exclude": ["node_modules", "plugin"]
}
